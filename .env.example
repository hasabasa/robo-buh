# === База ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=robobuh
POSTGRES_USER=robobuh
POSTGRES_PASSWORD=            # openssl rand -hex 16
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_URL=redis://redis:6379/0

# === Верификация ЭЦП (сервер только ПРОВЕРЯЕТ подпись; ключи клиентов сюда не попадают) ===
NCANODE_URL=http://ncanode:14579

# === Qwen (alem.ai) — классификация назначения платежа, PDF-выписки (vision) ===
QWEN_API_URL=
QWEN_API_KEY=

# === Kaspi Shop API (коннектор дохода Kaspi-продавцов; токен per-taxpayer в БД) ===
# Глобальных кредов нет — вечный X-Auth-Token хранится на каждого налогоплательщика.

# === Приложение ===
APP_SECRET_KEY=               # openssl rand -hex 32 — сессии/HMAC ссылок
BACKEND_URL=http://backend:8000
ENV=dev
